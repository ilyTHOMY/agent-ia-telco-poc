# ── App ───────────────────────────────────────────────────────────────────────
ENV=development
SECRET_KEY=change_me_in_production
LOG_LEVEL=info

# ── LLM Gemini ────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=AIza...
LLM_MODEL=gemini-2.5-flash
LLM_MAX_TOKENS=8192

# ── Base de donnees ───────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=agentia
POSTGRES_USER=agentia
POSTGRES_PASSWORD=agentia
DATABASE_URL=postgresql+asyncpg://agentia:agentia@postgres:5432/agentia

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Qdrant (RAG) ──────────────────────────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=knowledge_base

# ── Mock API (PoC) ────────────────────────────────────────────────────────────
USE_MOCK_APIS=true
MOCK_DATA_PATH=./data

# ── WhatsApp Business API ─────────────────────────────────────────────────────
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# ── Email (SendGrid) ──────────────────────────────────────────────────────────
SENDGRID_API_KEY=
EMAIL_FROM=support@agentia.ai

# ── USSD (AfricasTalking) ─────────────────────────────────────────────────────
AT_USERNAME=sandbox
AT_API_KEY=
AT_USSD_CODE=#144#

# ── Notifications ─────────────────────────────────────────────────────────────
NOTIFICATIONS_ENABLED=false
