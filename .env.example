# ── App ───────────────────────────────────────────────────────────────────────
ENV=development
SECRET_KEY=change_me_in_production
LOG_LEVEL=info
 
# ── LLM Gemini ────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=AIza...
LLM_MODEL=gemini-2.5-flash
LLM_MAX_TOKENS=8192
 
# ── Base de donnees ───────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=agentia
POSTGRES_USER=agentia
POSTGRES_PASSWORD=agentia
DATABASE_URL=postgresql+asyncpg://agentia:agentia@postgres:5432/agentia
 
# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
 
# ── Qdrant (RAG) ──────────────────────────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=knowledge_base
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
 
# ── Mock API (PoC) ────────────────────────────────────────────────────────────
USE_MOCK_APIS=true
MOCK_DATA_PATH=./data
 
# ── Email Gmail SMTP ──────────────────────────────────────────────────────────
# Mot de passe d'application Google (PAS ton vrai mot de passe)
# myaccount.google.com > Securite > Mots de passe des applications
GMAIL_USER=ton.email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_DESTINATAIRE=ton.email@gmail.com
 
# ── USSD (AfricasTalking) ─────────────────────────────────────────────────────
AT_USERNAME=sandbox
AT_API_KEY=
AT_USSD_CODE=#144#
 
# ── Notifications ─────────────────────────────────────────────────────────────
NOTIFICATIONS_ENABLED=false